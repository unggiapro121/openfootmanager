{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "scripts/*.mjs",
    "scripts/perf/*.mjs",
    ".github/scripts/*.mjs",
    "src/bindings/parity.ts",
    "src/online/index.ts"
  ],
  "project": ["src/**/*.{ts,tsx}", "scripts/**/*.mjs", ".github/scripts/**/*.mjs"],
  "ignoreDependencies": ["@fontsource/.*", "tailwindcss"],
  "ignoreExportsUsedInFile": true,
  "ignore": ["src/bindings/core/**", "src/online/api/**"]
}
